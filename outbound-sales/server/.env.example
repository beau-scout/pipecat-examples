# outbound-sales - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=

# Optional: the id (UUID) of a phone number purchased through Daily,
# used as the outbound caller ID
CALLER_ID=

# Environment mode: "local" for development, "production" for cloud deployment
ENV=local

# RunScout's main number, left in a voicemail when Hailey reaches a machine.
# Optional; defaults to 210-594-2600. (Read by the bot, so set it in the Pipecat
# Cloud secret set for production.)
MAIN_CALLBACK_NUMBER=210-594-2600

# Comma-separated region/state substrings whose calls are NOT recorded
# (two-party / all-party consent). Default: California. Matched against the
# lead's region (e.g. "California Charter"), case-insensitive.
NO_RECORD_REGIONS=California

# Local bot server URL (where bot.py runs)
LOCAL_SERVER_URL=http://localhost:7860

# Webhook server URL (where server.py runs); bots report call results here
SERVER_URL=http://localhost:7867

# Pipecat Cloud (only needed for production)
PIPECAT_API_KEY=
PIPECAT_AGENT_NAME=outbound-sales


# Text-to-Speech provider — Hailey's voice. "elevenlabs" (default; most
# natural-sounding) or "cartesia" (lowest latency and cost). Each provider
# reads its own voice ID below.
TTS_PROVIDER=elevenlabs

# ElevenLabs (TTS) — the default voice. REQUIRED when TTS_PROVIDER=elevenlabs.
# ELEVENLABS_VOICE_ID picks the voice (blank = "Rachel"); set it to any voice
# from the ElevenLabs library or a clone. ELEVENLABS_MODEL defaults to
# eleven_turbo_v2_5 (best quality/latency balance for phone calls).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Cartesia (TTS) — only used when TTS_PROVIDER=cartesia. CARTESIA_VOICE_ID is
# the voice Hailey speaks in; leave blank for the default.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (STT)
DEEPGRAM_API_KEY=


# Anthropic / Claude (LLM) — Hailey's brain
ANTHROPIC_API_KEY=
# Defaults to claude-opus-4-8. For the lowest phone-call latency, set
# claude-haiku-4-5 (fastest) or claude-sonnet-4-6. The eval judge also runs on
# Claude (claude-haiku-4-5 via eval_judge.claude_judge), so this same key covers
# both the bot and `pipecat eval`.
ANTHROPIC_MODEL=claude-opus-4-8


# Apollo.io — enroll captured school-security contacts for team follow-up.
# Leave APOLLO_API_KEY blank to disable the Apollo integration entirely.
# Create a REST API key in Apollo under Settings > Integrations > API.
APOLLO_API_KEY=
# The sequence captured contacts are added to. Defaults to the
# "Runscout School Safety — K-12 Outreach" sequence.
APOLLO_SEQUENCE_ID=6a343ebde13d870014734823
# The Apollo email account contacts are enrolled under. Defaults to xiomara@runscout.ai.
APOLLO_EMAIL_ACCOUNT_ID=6a17148fcb8db60014f18f9b
# "paused" holds contacts for a teammate to review before any email sends;
# "active" starts the sequence immediately.
APOLLO_ENROLL_STATUS=paused

