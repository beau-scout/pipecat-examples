# EyePop.ai credentials — copy this file to ".env" and fill in.
# Get these from https://dashboard.eyepop.ai (Pop -> API/SDK).

# Required: your EyePop secret API key.
EYEPOP_SECRET_KEY=

# Required: the Pop id of a Pop configured for "Person w/ Demographic Data"
# (person detection + age-range + gender). Create it in the EyePop dashboard.
EYEPOP_POP_ID=

# Optional: override the API base URL (leave blank for default).
# EYEPOP_URL=

# Optional: a separate Pop id used for door open/closed detection, if you run
# doors through a dedicated EyePop Pop (see config.yaml -> doors.mode: eyepop).
# EYEPOP_DOOR_POP_ID=
